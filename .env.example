# Use the zone apex, without a hostname prefix.
BASE_DOMAIN=example.com
ACME_EMAIL=admin@example.com
# Generate with: openssl rand -hex 24
DASHBOARD_TOKEN=replace-with-a-long-random-token

# Free GeoLite2 account credentials from MaxMind.
MAXMIND_ACCOUNT_ID=replace-with-account-id
MAXMIND_LICENSE_KEY=replace-with-license-key
# Hours between database update checks.
GEOIPUPDATE_FREQUENCY=72
